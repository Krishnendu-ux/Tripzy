# Google Places API Key (from Google Cloud Console: Places API / Places New)
VITE_GOOGLE_PLACE_API_KEY=your_google_place_api_key_here

# Google Gemini AI API Key (from Google AI Studio: https://aistudio.google.com/)
VITE_GOOGLE_GEMINI_AI_API_KEY=your_gemini_api_key_here

# Google OAuth Client ID (from Google Cloud Console: Credentials -> OAuth 2.0 Client IDs)
VITE_GOOGLE_AUTH_CLIENT_ID=your_google_oauth_client_id_here
